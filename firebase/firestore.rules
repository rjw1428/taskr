rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /todos/{userId}/{document=**} {
      allow read, write: if request.auth.uid == userId;
    }
    // Collection-group read so the backlog can gather a parent's subtasks
    // across date partitions. Scoped to the owner via the denormalized userId
    // field on each task item (see add-subtasks).
    match /{path=**}/items/{itemId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
    }
    match /todos/{userId} {
       allow read, write: if request.auth.uid == userId;
    }
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth.uid == userId;
    }
    match /secrets/{userId} {
      allow read, write: if false;
    }
    match /secrets/{userId}/{document=**} {
      allow read, write: if false;
    }
    // match /{document=**} {
    //   allow read, write: if request.auth != null;
    // }
  }
}